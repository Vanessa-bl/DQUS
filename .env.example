# Lead delivery for the accountants landing form.
# The form always delivers to hello@devqueens.us.
# Both values are server-only. Never prefix them with NEXT_PUBLIC_.

# Resend (recommended): create an API key and verify devqueens.us first.
RESEND_API_KEY=
LEADS_FROM_EMAIL="DevQueens <leads@devqueens.us>"

# Optional alternative: any webhook that accepts a JSON POST (Zapier, Make, Slack, etc.).
# LEADS_WEBHOOK_URL=
